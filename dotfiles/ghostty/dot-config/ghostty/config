shell-integration = detect
shell-integration-features = cursor,ssh-terminfo,ssh-env,title,sudo
# background-opacity = 0.95
background-opacity = 0.8
font-family = "JetBrainsMono Nerd Font"
cursor-style=bar
mouse-hide-while-typing = true
background-blur = true
theme = catppuccin-mocha.conf

clipboard-read = allow
clipboard-write = allow

keybind = ctrl+s>r=reload_config
keybind = ctrl+s>shift+'=new_split:down
keybind = ctrl+s>shift+5=new_split:right
keybind = ctrl+s>x=close_surface
keybind = ctrl+s>j=goto_split:down
keybind = ctrl+s>k=goto_split:up
keybind = ctrl+s>h=goto_split:left
keybind = ctrl+s>l=goto_split:right
keybind = ctrl+s>z=toggle_split_zoom
